<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback Configuration for Jyoti Bank Management System

    Two appenders are configured:
    1. CONSOLE: Human-readable output during development
    2. FILE:    Rolling daily log files (kept 30 days) for production audit

    The application logger (com.jyotibank) is set to DEBUG so you can
    see detailed bank operation logs during development.
    Third-party libraries (HikariCP, MySQL) are set to WARN to suppress noise.
-->
<configuration>

    <property name="LOG_DIR"  value="logs"/>
    <property name="APP_NAME" value="jyoti-bank"/>

    <!-- ══════════════ CONSOLE APPENDER ══════════════ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
                Pattern breakdown:
                %d{HH:mm:ss.SSS}  — timestamp (time only, short for console)
                [%thread]          — thread name (important for concurrency debugging)
                %-5level           — log level, left-padded to 5 chars
                %logger{36}        — class name, truncated to 36 chars
                %msg%n             — the actual log message + newline
            -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ══════════════ ROLLING FILE APPENDER ══════════════ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>

        <!-- Roll over to a new file each day; keep 30 days of history -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <!-- Cap total log storage at 500MB regardless of maxHistory -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <!-- Full timestamp in file logs for precise audit trails -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ══════════════ LOGGER CONFIGURATION ══════════════ -->

    <!-- Our application: DEBUG level so we see all banking operations -->
    <logger name="com.jyotibank" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Suppress HikariCP verbose startup logs -->
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- Suppress MySQL driver internal logs -->
    <logger name="com.mysql" level="WARN"/>

    <!-- Root logger: catches anything not matched above -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
